{
  "name": "pdf-annotations",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Marco Infanti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcoInfanti/pdf-annotator.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" \"README*.md\" playwright.config.ts eslint.config.js",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" \"README*.md\" playwright.config.ts eslint.config.js",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:headed": "playwright test --headed",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ngx-translate/core": "18.0.0",
    "marked": "^15.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.36",
    "@angular/cli": "^20.3.36",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "26.6.5",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.0"
  }
}
